# API base URL. Real phone: LAN IP of the computer (http://192.168.x.x:4000);
# Android emulator: http://10.0.2.2:4000; iOS simulator: http://localhost:4000.
EXPO_PUBLIC_API_URL=http://localhost:4000
# EAS project id (needed for Expo push tokens). Leave empty to skip push.
EXPO_PUBLIC_EAS_PROJECT_ID=
